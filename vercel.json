{
  "version": 2,
  "functions": {
    "api/discord.js": {
      "maxDuration": 30
    },
    "api/marketplace-setup.js": {
      "maxDuration": 30
    },
    "api/marketplace.js": {
      "maxDuration": 30
    },
    "api/market-proof.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/downloads/credits/",
      "destination": "/downloads/credits/index.html"
    },
    {
      "source": "/downloads/credits",
      "destination": "/downloads/credits/index.html"
    },
    {
      "source": "/downloads",
      "destination": "/downloads/index.html"
    },
    {
      "source": "/downloads/",
      "destination": "/downloads/index.html"
    },
    {
      "source": "/hosting",
      "destination": "/hosting/index.html"
    },
    {
      "source": "/hosting/",
      "destination": "/hosting/index.html"
    },
    {
      "source": "/join",
      "destination": "/join/index.html"
    },
    {
      "source": "/join/",
      "destination": "/join/index.html"
    },
    {
      "source": "/store",
      "destination": "/index.html"
    },
    {
      "source": "/track",
      "destination": "/index.html"
    },
    {
      "source": "/product/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/checkout/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/downloads/android",
      "destination": "https://cdn.abszrpg.shop/downloads/0.9.1/Absz-Dungeon-GO-v0.9.1-Online-ARM64.apk",
      "permanent": false
    },
    {
      "source": "/downloads/windows",
      "destination": "https://cdn.abszrpg.shop/downloads/0.9.1/Absz-Dungeon-GO-v0.9.1-Windows-PC.zip",
      "permanent": false
    },
    {
      "source": "/downloads/checksums",
      "destination": "https://cdn.abszrpg.shop/downloads/0.9.1/SHA256SUMS.txt",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/downloads/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://br-summer-cherry-a15duloj-game.compute.c-1.ap-southeast-1.aws.neon.tech; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/_channels/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/downloads/release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
