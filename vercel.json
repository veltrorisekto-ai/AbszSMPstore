{
  "version": 2,
  "functions": {
    "api/discord.js": {
      "maxDuration": 30
    },
    "api/marketplace-setup.js": {
      "maxDuration": 30
    },
    "api/marketplace.js": {
      "maxDuration": 30
    },
    "api/market-proof.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/hosting",
      "destination": "/hosting/index.html"
    },
    {
      "source": "/hosting/",
      "destination": "/hosting/index.html"
    },
    {
      "source": "/join",
      "destination": "/join/index.html"
    },
    {
      "source": "/join/",
      "destination": "/join/index.html"
    },
    {
      "source": "/store",
      "destination": "/index.html"
    },
    {
      "source": "/track",
      "destination": "/index.html"
    },
    {
      "source": "/product/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/checkout/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    }
  ]
}
