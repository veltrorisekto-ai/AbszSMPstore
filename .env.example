# Required for production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
DISCORD_BOT_TOKEN=configure-privately-in-vercel

# Optional: the Discord public key may instead be saved in the Admin Integrations page.
DISCORD_PUBLIC_KEY=

# Optional email password recovery
RESEND_API_KEY=
RESEND_FROM=

# Optional fallback if you do not generate the bridge key from the Admin panel.
BRIDGE_API_KEY_HASH=
